# Which provider to call: "deepseek" (direct, recommended) or "openrouter"
DEEPSEEK_PROVIDER=deepseek

# --- Direct DeepSeek (used when DEEPSEEK_PROVIDER=deepseek) ---
# Get your key from https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-your-key-here

# --- OpenRouter (used when DEEPSEEK_PROVIDER=openrouter) ---
# Get your key from https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-your-key-here

# Model to use for code generation. Defaults per provider:
#   deepseek   -> deepseek-coder   (also: deepseek-chat, deepseek-reasoner)
#   openrouter -> deepseek/deepseek-coder (also: deepseek/deepseek-chat, etc.)
# Leave unset to use the provider's default.
# DEEPSEEK_MODEL=deepseek-coder
